# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stock_market
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Initial Virtual Account Balance
INITIAL_BALANCE=100000.00
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# Python Executable Path (ensure Python with yfinance is selected)
PYTHON_PATH=python

# Application Settings
POLLING_INTERVAL_SECONDS=30
MOCK_DATA=false
